APP_NAME=KG Multi-Agent Demo
ENVIRONMENT=dev

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ZEP_API_KEY=
ZEP_BASE_URL=https://api.getzep.com

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

POSTGRES_DSN=postgresql+psycopg://postgres:postgres@postgres:5432/agentdb
REDIS_URL=redis://redis:6379/0

MAX_REVISION_LOOPS=2
NODE_TIMEOUT_SECONDS=30

SIDE_EFFECT_DEFAULT_MODE=simulation
SIDE_EFFECT_LIVE_TOOLS_CSV=content_publish
